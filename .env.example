# Copy to .env.local and fill in. Never commit .env.local.

# X (developer.x.com > your app > Keys and tokens). The app needs Read and write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn (developer.linkedin.com app with the "Share on LinkedIn" product)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX

# Optional: require this header on /api/publish-due (set the same value for the scheduler)
PULSE_CRON_SECRET=
